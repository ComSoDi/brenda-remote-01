# android-shell/keystore.properties.example
# Copy this to `keystore.properties` (same directory) and fill in the real
# values. `keystore.properties` itself is gitignored — never commit it, and
# never commit the .keystore file it points at either.
#
# Real values for Brenda's existing upload key (verified against Play
# Console 2026-09-26 — App signing key + Upload key certificates both
# confirmed matching):
#   storeFile   = the path to signing.keystore, currently at
#      D:\00_AI\Brenda\Google Play Store\PWA Builder\Brenda - Google Play package_07\signing.keystore
# BUT DO NOT USE BACKSLASHES. They should be FORWARD slashes like so:
#   storeFile=D:/00_AI/Brenda/Google Play Store/PWA Builder/Brenda - Google Play package_07/signing.keystore
#   keyAlias    = brenda-key-01
#   storePassword / keyPassword = see signing-key-info.txt in that same folder

storeFile=CHANGE_ME_absolute_path_to_signing.keystore
storePassword=CHANGE_ME
keyAlias=brenda-key-01
keyPassword=CHANGE_ME
